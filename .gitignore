# JSON Configuration & Template Safelist
# (Prevent accidental commits of active run states, logs, or credentials while preserving templates & configs)
*.json
!rise_omr_template.json
!list1_template.json
!list2_template.json
!firebase.json
!pyrightconfig.json
!package.json
!package-lock.json
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
!frontend/.oxlintrc.json
!frontend/src/**/*.json

# Local processing, cache, and scanned bulk files
output/
uploads/
processed/
temp/
OMR_SCAN/inbox/*
!OMR_SCAN/inbox/.gitkeep
OMR_SCAN/processing/*
!OMR_SCAN/processing/.gitkeep
OMR_SCAN/processed/*
!OMR_SCAN/processed/.gitkeep
OMR_SCAN/failed/*
!OMR_SCAN/failed/.gitkeep
OMR_SCAN/archive/*
!OMR_SCAN/archive/.gitkeep
OMR_SCAN/review/*
!OMR_SCAN/review/.gitkeep
OMR_SCAN/active_batch.json

# Logs & Debug dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firestore-debug.log
firebase-debug.log

# IDE & Editor files
.vscode/
.idea/